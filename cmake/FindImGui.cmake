find_path(ImGui_INCLUDE_DIR "imgui.h" HINTS ${IMGUI_DIR})

set(ImGui_INCLUDE_DIRS ${ImGui_INCLUDE_DIR})
set(ImGui_SOURCES)
set(ImGui_Sources_FOUND TRUE)
set(_ImGui_FILES imgui.cpp imgui_draw.cpp imgui_widgets.cpp imgui_tables.cpp imgui_demo.cpp)

if(WIN32)
    list(APPEND _ImGui_FILES imgui_impl_win32.cpp imgui_impl_dx12.cpp imgui_impl_win32.h imgui_impl_dx12.h)
    if(IS_DIRECTORY "${ImGui_INCLUDE_DIR}/backends")
        list(APPEND ImGui_INCLUDE_DIRS "${ImGui_INCLUDE_DIR}/backends")
    endif()
endif()

foreach(_ImGui_FILE IN LISTS _ImGui_FILES)
    if(EXISTS "${ImGui_INCLUDE_DIR}/${_ImGui_FILE}")
        list(APPEND ImGui_SOURCES "${ImGui_INCLUDE_DIR}/${_ImGui_FILE}")
    elseif(WIN32 AND EXISTS "${ImGui_INCLUDE_DIR}/backends/${_ImGui_FILE}")
        list(APPEND ImGui_SOURCES "${ImGui_INCLUDE_DIR}/backends/${_ImGui_FILE}")
    else()
        set(ImGui_Sources_FOUND FALSE)
    endif()
endforeach()

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(ImGui REQUIRED_VARS ImGui_INCLUDE_DIR ImGui_Sources_FOUND HANDLE_COMPONENTS)

if(ImGui_FOUND)
    if(NOT TARGET ImGui::ImGui)
        add_library(ImGui::ImGui INTERFACE IMPORTED)
        set_target_properties(ImGui::ImGui PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${ImGui_INCLUDE_DIRS}")
    endif()
    if(NOT TARGET ImGui::Sources)
        add_library(ImGui::Sources INTERFACE IMPORTED)
        set_target_properties(ImGui::Sources PROPERTIES INTERFACE_SOURCES "${ImGui_SOURCES}" INTERFACE_LINK_LIBRARIES ImGui::ImGui)
        if(WIN32)
            set_property(TARGET ImGui::Sources APPEND PROPERTY INTERFACE_LINK_LIBRARIES d3d12 dxgi d3dcompiler dwmapi)
        endif()
    endif()
endif()

mark_as_advanced(ImGui_INCLUDE_DIR)
unset(_ImGui_FILES)
unset(_ImGui_FILE)
